# ms-usuarios — plantilla de variables de entorno
# Copia a `.env` y completa. NUNCA subas `.env` a git.

# --- Base de datos ---
DB_HOST=
DB_PORT=5432
DB_NAME=moneipe_usuarios
DB_USER=moneipe
DB_PASSWORD=

# --- Keycloak (issuer del realm por ambiente) ---
KEYCLOAK_ISSUER_URI=

# --- Keycloak Admin API (service account) ---
KEYCLOAK_ADMIN_BASE_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
